{
  "name": "minicode-agent",
  "version": "0.1.0",
  "description": "A small reason-execute-verify coding agent CLI",
  "type": "module",
  "bin": {
    "minicode-agent": "dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md"
